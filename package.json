{
  "name": "allegra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:mobile": "npm --prefix apps/mobile start",
    "mock": "node mocks/server.mjs",
    "contract-test": "node tests/contract/contract-smoke.mjs",
    "infra:test": "node --test tests/infra/infra-files.test.mjs tests/infra/mobile-release-notes.test.mjs",
    "convex:test": "node --import tsx --test tests/convex/authRedirect.test.ts && vitest run --maxWorkers=1 convex/connect.test.ts convex/account.test.ts convex/retention.test.ts convex/taste.test.ts convex/library.test.ts convex/blends.test.ts convex/luvLink.test.ts",
    "sync:shared": "node scripts/sync-shared.mjs",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm test --workspaces --if-present && npm run infra:test && npm run convex:test",
    "build": "npm run build --workspaces --if-present",
    "e2e": "playwright test -c tests/e2e/playwright.config.ts",
    "mobile:check": "npm --prefix apps/mobile run ci"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@convex-dev/auth": "^0.0.95",
    "@convex-dev/presence": "^0.4.0",
    "@convex-dev/rate-limiter": "^0.4.0",
    "convex": "^1.46.0"
  },
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/*"
  ],
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@playwright/test": "^1.63.0",
    "convex-test": "^0.0.60",
    "vitest": "^5.0.2"
  },
  "license": "GPL-3.0-only"
}
