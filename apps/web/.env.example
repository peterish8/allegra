# Blank = same-origin /api (correct for both dev and Vercel).
NEXT_PUBLIC_API_BASE_URL=

# Convex deployment that owns sign-in. Blank = guest-only, no Google button.
NEXT_PUBLIC_CONVEX_URL=

# Feature flags (PLAN.md D18). Booleans only: NEXT_PUBLIC_* is inlined into the public bundle.
# Each needs its API twin (IMPORT_ENABLED / BLEND_ENABLED in apps/api/.env) to be useful.
# NEXT_PUBLIC_IMPORT_ENABLED=true
# NEXT_PUBLIC_BLEND_ENABLED=true
