<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
  <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
  <!-- Scanning LuvLyrics codes (Search → camera). Asked only when the scanner opens. -->
  <uses-permission android:name="android.permission.CAMERA"/>
  <uses-feature android:name="android.hardware.camera" android:required="false"/>
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>
  <uses-permission android:name="android.permission.INTERNET"/>
  <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
  <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>
  <!-- Least privilege (.planning/mobile-security/ANDROID-PERMISSIONS-AUDIT-2026-11-13.md, src/androidPermissions.test.ts).
       No accessibility service, notification listener or SMS access: Play Protect blocks a sideloaded app that declares
       them, and Google Pay pauses payments while a non-Play app holds accessibility. -->
  <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"/>
  <!-- Settings → import songs on this phone (services/mediaScanner.ts, audio only). Asked on that tap. -->
  <uses-permission android:name="android.permission.READ_MEDIA_AUDIO"/>
  <!-- Covers are picked through Android's photo picker, which needs no access to the photo or video library. -->
  <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" tools:node="remove"/>
  <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" tools:node="remove"/>
  <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" tools:node="remove"/>
  <!-- Voice search (hooks/useVoiceCommands.ts). Asked on the first mic press; speech stays with Android's recognizer. -->
  <uses-permission android:name="android.permission.RECORD_AUDIO"/>
  <!-- Nothing draws over other apps. -->
  <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" tools:node="remove"/>
  <uses-permission android:name="android.permission.VIBRATE"/>
  <uses-permission android:name="android.permission.WAKE_LOCK"/>
  <!-- Android 12 and older only: expo-media-library reads songs there only with read and write granted together. -->
  <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="32" tools:replace="android:maxSdkVersion"/>
  <!-- Player menu → Set as ringtone (the user grants it on the system "modify settings" page). -->
  <uses-permission android:name="android.permission.WRITE_SETTINGS" tools:ignore="ProtectedPermissions"/>
  <queries>
    <intent>
      <action android:name="android.intent.action.VIEW"/>
      <category android:name="android.intent.category.BROWSABLE"/>
      <data android:scheme="https"/>
    </intent>
  </queries>
  <application android:name=".MainApplication" android:label="@string/app_name" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher_round" android:allowBackup="true" android:fullBackupContent="@xml/secure_store_backup_rules" android:dataExtractionRules="@xml/secure_store_data_extraction_rules" android:theme="@style/AppTheme" android:supportsRtl="true" android:enableOnBackInvokedCallback="false" android:requestLegacyExternalStorage="true">
    <provider android:name="androidx.core.content.FileProvider" android:authorities="${applicationId}.updates" android:exported="false" android:grantUriPermissions="true">
      <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/update_file_paths"/>
    </provider>
    <meta-data android:name="expo.modules.updates.ENABLED" android:value="false"/>
    <meta-data android:name="expo.modules.updates.EXPO_UPDATES_CHECK_ON_LAUNCH" android:value="ALWAYS"/>
    <meta-data android:name="expo.modules.updates.EXPO_UPDATES_LAUNCH_WAIT_MS" android:value="0"/>
    <activity android:name=".MainActivity" android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|uiMode" android:launchMode="singleTask" android:windowSoftInputMode="adjustResize" android:theme="@style/Theme.App.SplashScreen" android:exported="true" android:screenOrientation="portrait">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.VIEW"/>
        <category android:name="android.intent.category.DEFAULT"/>
        <category android:name="android.intent.category.BROWSABLE"/>
        <data android:scheme="lyricflow"/>
        <data android:scheme="exp+lyricflow"/>
      </intent-filter>
      <!-- Share links (1.44.0, packages/shared/shareLinks.ts): a tapped link to a shared song, public playlist, Blend or
           LuvLink invite opens here when the app is installed, the website otherwise. autoVerify checks
           apps/web/public/.well-known/assetlinks.json, which lists this build's signing certificate. -->
      <intent-filter android:autoVerify="true">
        <action android:name="android.intent.action.VIEW"/>
        <category android:name="android.intent.category.DEFAULT"/>
        <category android:name="android.intent.category.BROWSABLE"/>
        <data android:scheme="https"/>
        <data android:host="allegravibe.vercel.app"/>
        <data android:pathPrefix="/song/"/>
        <data android:pathPrefix="/shared/"/>
        <data android:pathPrefix="/blend/join/"/>
        <data android:pathPrefix="/luvlink/join/"/>
      </intent-filter>
    </activity>

    <!-- The way out of a build that cannot open (recovery/RescueActivity.kt): native, no React. -->
    <activity android:name=".recovery.RescueActivity" android:exported="false" android:theme="@style/AppTheme" android:screenOrientation="portrait" android:label="@string/app_name"/>

    <!-- Media3 session service — supplies the system media notification, lock
         screen controls, Bluetooth/Android Auto. The intent-filter is required
         for Media3 to discover the session. -->
    <service android:name=".services.PlaybackService"
        android:foregroundServiceType="mediaPlayback"
        android:exported="true">
      <intent-filter>
        <action android:name="androidx.media3.session.MediaSessionService"/>
      </intent-filter>
    </service>
    <!-- Home-screen widgets (react-native-android-widget); mirrors the plugin config in app.json. -->
    <service android:name="com.reactnativeandroidwidget.RNWidgetCollectionService" android:permission="android.permission.BIND_REMOTEVIEWS"/>
    <receiver android:name=".widget.NowPlaying" android:exported="false" android:label="Now playing">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
        <action android:name="com.lyricflow.app.WIDGET_CLICK"/>
      </intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/widgetprovider_nowplaying"/>
    </receiver>
    <receiver android:name=".widget.Playlist" android:exported="false" android:label="Playlist">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
        <action android:name="com.lyricflow.app.WIDGET_CLICK"/>
      </intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/widgetprovider_playlist"/>
    </receiver>
  </application>
</manifest>
