{
  "expo": {
    "name": "LuvLyrics",
    "slug": "lyricflow",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/luvlyrics-icon-white.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "jsEngine": "hermes",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lyricflow.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/luvlyrics-adaptive-white.png",
        "backgroundColor": "#020A16"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.lyricflow.app",
      "scheme": "lyricflow",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.REQUEST_INSTALL_PACKAGES",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.WAKE_LOCK",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.WRITE_SETTINGS"
      ]
    },
    "plugins": [
      "@sentry/react-native/expo",
      "expo-sqlite",
      "expo-audio",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow LuvLyrics to access your photos so you can set custom playlist covers."
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "NowPlaying",
              "label": "Now playing",
              "description": "The song that's playing, with play, skip and like",
              "minWidth": "180dp",
              "minHeight": "180dp",
              "targetCellWidth": 3,
              "targetCellHeight": 3,
              "maxResizeWidth": "360dp",
              "maxResizeHeight": "360dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 0
            },
            {
              "name": "Playlist",
              "label": "Playlist",
              "description": "A playlist you can scroll and play from",
              "minWidth": "250dp",
              "minHeight": "180dp",
              "targetCellWidth": 4,
              "targetCellHeight": 3,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 0
            }
          ]
        }
      ],
      "expo-secure-store",
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "c1057836-feb4-4f08-b177-7efc8bc2b4b3"
      }
    }
  }
}
